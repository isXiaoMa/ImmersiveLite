{
  "manifest_version": 2,
  "name": "沉浸式翻译助手",
  "version": "1.0.0",
  "description": "双语对照网页翻译：支持谷歌翻译、百度翻译、OpenAI 兼容大模型等多种翻译服务",
  "browser_specific_settings": {
    "gecko": {
      "id": "immersive-translate-assistant@demo.example",
      "strict_min_version": "112.0"
    }
  },
  "permissions": ["storage", "activeTab", "contextMenus", "<all_urls>"],
  "background": {
    "scripts": [
      "utils/compat.js",
      "utils/languages.js",
      "utils/md5.js",
      "background/service-worker.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils/compat.js", "utils/site-rules.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "沉浸式翻译助手（Alt+Q 切换翻译）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "翻译 / 还原当前页面"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
